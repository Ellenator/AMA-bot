<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ellenators AMA-botti</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <main>

        <section class="profil">
            <h2>Vær hilset!</h2>
            <p>- og velkommen til min chattibotti</p>
        </section>

        <section class="chat">
            <form method="POST" action="/ask">
                <label for="question" id="text">Lær mig bedre at kende her:</label>
                <input type="text" id="question" name="question" placeholder="Spørg mig om noget..." autocomplete="off" />
                <button type="submit">Send</button>
            </form>
        </section>

    <% for (const message of messages) { %>
        <p><%= message %></p>
    <% } %>

        
    </main>
</body>
</html>