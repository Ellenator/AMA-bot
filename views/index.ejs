<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ellenators AMA-botti</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <main>

        <section class="profil">
            <h2>Vær hilset!</h2>
            <p>- og velkommen til min chattibotti</p>
        </section>

        <section class="chat">
            <div class="chat-messages">
                <% for (const message of messages) { %>
                    <article class="<%= message.type %>">
                        <p><%= message.text %></p>
                    </article>
                <% } %>
            </div>

            <h2>Spørgsmål fordelt på emner</h2>
            <ul>
                <li>Navn: <%= topicStats.navn %></li>
                <li>Bosted: <%= topicStats.bosted %></li>
                <li>Hobbier: <%= topicStats.hobbier %></li>
                <li>Frygter: <%= topicStats.frygter %></li>
            </ul>

            <form method="POST" action="/ask">
                <input type="text" id="question" name="question" placeholder="Spørg mig om noget..." autocomplete="off" />
                <button type="submit">Send</button>
            </form>

            <% if (error) { %>
                <p role="alert"><%= error %></p>
            <% } %>

        </section>

    </main>

    <script>
    // Finder det ALLERSIDSTE spørgsmål i chatten
        const questions = document.querySelectorAll('.question');
        const lastQuestion = questions[questions.length - 1];

        if (lastQuestion) {
    // Ruller så toppen af spørgsmålet flugter med toppen af chat-vinduet
        lastQuestion.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    </script>

    <script src="/script.js"></script>

</body>
</html>